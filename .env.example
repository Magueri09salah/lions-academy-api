APP_NAME="Lions Academy API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lions_academy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@lionsacademy.ma"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Sanctum / SPA auth ----------
# Domains that are allowed to authenticate via cookie (comma separated, no protocol).
# Leave empty if you only use Bearer tokens cross-origin.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080,127.0.0.1:8080
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# ---------- CORS ----------
# Comma-separated full origins for the public frontend and admin app.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ---------- Lions Academy app ----------
LIONS_FRONTEND_URL=http://localhost:5173
LIONS_ADMIN_URL=http://localhost:5173/admin
LIONS_ADMIN_EMAIL=admin@lionsacademy.ma
LIONS_ADMIN_PASSWORD=ChangeMe!2026
LIONS_NOTIFY_EMAIL=contact@lionsacademy.ma

# Academy WhatsApp number (digits only — e.g. 212600000000). Used in
# registration responses and notification emails.
LIONS_WHATSAPP_NUMBER=212693459907
LIONS_WHATSAPP_MESSAGE="Bonjour Lions Academy, je souhaite avoir plus d'informations sur la formation."

# Public storage URLs.
# Set FILESYSTEM_DISK=public and run `php artisan storage:link`.

# ---------- Spam protection (preparation) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HONEYPOT_FIELD=_hp_field
HONEYPOT_TIMER_FIELD=_hp_time

# ---------- Rate limits ----------
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_PUBLIC_WRITE_PER_HOUR=10
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_ADMIN_PER_MINUTE=120

# ---------- File uploads ----------
UPLOAD_MAX_IMAGE_KB=8192
UPLOAD_MAX_DOCUMENT_KB=10240
# 200 MB default for landing-page videos. Requires matching
# upload_max_filesize and post_max_size in php.ini.
UPLOAD_MAX_VIDEO_KB=204800
